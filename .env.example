# Safe development defaults only. Copy to .env.local and replace locally as needed.
APPLICATION_TRAIL_API_PORT=4310
APPLICATION_TRAIL_WEB_PORT=4320
APPLICATION_TRAIL_PUBLIC_URL=http://127.0.0.1:4320
APPLICATION_TRAIL_API_INTERNAL_URL=http://127.0.0.1:4310
APPLICATION_TRAIL_EXTENSION_ORIGIN=http://127.0.0.1:4320
DATABASE_URL=postgresql://application_trail:application_trail_dev_only@127.0.0.1:5432/application_trail

# Google OAuth. The callback is APPLICATION_TRAIL_PUBLIC_URL + /auth/google/callback.
GOOGLE_OAUTH_CLIENT_ID=replace-with-public-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-locally-do-not-commit
APPLICATION_TRAIL_AUTH_SECRET=replace-with-a-long-random-local-secret

# Explicit troubleshooting escape hatch only. Do not enable in hosted environments.
APPLICATION_TRAIL_ENABLE_DEV_IDENTITY=false

# Optional SSH tunnel used by `npm run dev` when DATABASE_URL points at a forwarded local port.
# APPLICATION_TRAIL_SSH_HOST=user@studio-vps
# APPLICATION_TRAIL_SSH_IDENTITY_FILE=C:\\Users\\you\\.ssh\\id_ed25519
# APPLICATION_TRAIL_SSH_LOCAL_PORT=55432
# APPLICATION_TRAIL_SSH_REMOTE_HOST=127.0.0.1
# APPLICATION_TRAIL_SSH_REMOTE_PORT=5432
