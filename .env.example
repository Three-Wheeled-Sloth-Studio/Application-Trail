# Safe development defaults only. Copy to .env.local and replace locally as needed.
APPLICATION_TRAIL_API_PORT=4310
APPLICATION_TRAIL_WEB_PORT=4320
APPLICATION_TRAIL_WEB_URL=http://localhost:4320
DATABASE_URL=postgresql://application_trail:application_trail_dev_only@localhost:5432/application_trail
GOOGLE_OAUTH_CLIENT_ID=replace-with-public-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-locally-do-not-commit
APPLICATION_TRAIL_ENABLE_DEV_IDENTITY=false
