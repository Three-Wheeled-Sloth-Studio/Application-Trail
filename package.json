{
  "name": "application-trail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check:case-collisions": "node scripts/check-case-collisions.mjs",
    "generate:refs": "node refs/tools/generate-okf-indexes.mjs",
    "validate:refs": "node refs/tools/validate-refs.mjs",
    "prebuild": "npm run check:case-collisions",
    "build": "npm run build -w @application-trail/domain && npm run build -w @application-trail/api && npm run build -w @application-trail/extension && npm run build -w @application-trail/web",
    "pretypecheck": "npm run check:case-collisions",
    "typecheck": "npm run build -w @application-trail/domain && npm run typecheck --workspaces --if-present",
    "test": "npm run build && node --test tests/*.test.mjs",
    "validate": "npm run validate:refs && npm run typecheck && npm test",
    "dev": "node --env-file=.env.local scripts/dev.mjs",
    "migrate": "node --env-file=.env.local apps/api/scripts/migrate.mjs",
    "start:api": "node --env-file=.env.local apps/api/dist/server.js",
    "start:web": "node --env-file=.env.local apps/web/scripts/serve.mjs"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "typescript": "5.8.3",
    "yaml": "^2.8.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
